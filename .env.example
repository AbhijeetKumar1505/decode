# Select one provider: openrouter, openai, or anthropic.
DECODE_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Any model slug from the OpenRouter registry (":free" variants share a
# rate-limited upstream pool; add your own provider key on OpenRouter for
# dedicated limits).
DECODE_MODEL=z-ai/glm-5.2:free
# Optional: model used for memory embeddings (defaults to a free OpenRouter model).
# OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b-20260716:free

# OpenAI example
# DECODE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic example
# DECODE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

DECODE_EXECUTOR=local
MAX_ITERATIONS=20
# Persistent web search engine for the agent (default: duckduckgo).
DECODE_SEARCH_ENGINE=duckduckgo
MEMORY_PATH=./data/models/
LOGS_PATH=./logs/
AUDIT_PATH=./audit/
FEEDBACK_PATH=./feedback/
TOOL_REGISTRY_PATH=./data/tool_registry.json
PROFILES_PATH=./profiles/

# Optional MongoDB operational backend.
# When MONGODB_URI is set, the app uses MongoDB instead of local SQLite.
# Leaving it unset keeps the default local-first SQLite store.
# A <db_password> placeholder in the URI is filled from MONGODB_PASSWORD (URL-encoded).
# MONGODB_URI=mongodb+srv://user:<db_password>@cluster0.example.mongodb.net/?appName=Cluster0
# MONGODB_PASSWORD=
# MONGODB_DB=decode
